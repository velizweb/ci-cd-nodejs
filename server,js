import express from 'express'; // Sintaxis ES2015

const app = express();
const PORT = 8080;

// Ruta base usando una función flecha
app.get('/', (req, res) => {
  res.send('¡Hola Mundo con Express y ES2015!');
});

app.listen(PORT, () => {
  console.log(`Servidor escuchando en http://localhost:${PORT}`);
});